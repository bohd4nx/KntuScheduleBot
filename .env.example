# Токен бота від @BotFather
BOT_TOKEN=your_bot_token_here

# Refresh-токен порталу ЦНТУ: cookie staffportal_refresh з portal.kntu.kr.ua (DevTools → Application → Cookies).
# Портал ротує його при кожному оновленні сесії — актуальний токен бот зберігає в Redis,
# тому змінну треба міняти, лише коли токен протух або Redis порожній.
PORTAL_REFRESH_TOKEN=your_portal_refresh_token

# Redis (токен порталу + кеш розкладу). Для запуску поза docker compose.
REDIS_URL=redis://localhost:6379/0

# Чат (id), куди щодня о 6:00 за Києвом приходить розклад на день; на вихідних не надсилається. Порожньо — вимкнено.
GROUP_ID=
